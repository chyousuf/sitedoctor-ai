# ========================================================
# SiteDoctor AI - Environment Configuration Example
# ========================================================

# Database (PostgreSQL for production / SQLite for zero-friction local development)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://sitedoctor:sitedoctor_secret@localhost:5432/sitedoctor_db?schema=public"

# Application Security & Master Encryption Key (32-byte hex for AES-256-GCM)
# Generate with: openssl rand -hex 32
VAULT_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
APP_SECRET="replace-with-a-random-32-character-secret-key-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Provider Configuration (Provider-Neutral: openai | anthropic | gemini | mock)
AI_PROVIDER="mock"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Crawler Configuration & Safety Bounds
CRAWLER_USER_AGENT="SiteDoctorAI-Bot/1.0 (+https://sitedoctor.ai/bot)"
MAX_PAGES_DEFAULT=50
MAX_DEPTH_DEFAULT=4
MAX_CONCURRENT_REQUESTS_PER_HOST=3
CRAWL_TIMEOUT_MS=15000
MAX_RESPONSE_SIZE_BYTES=10485760 # 10MB

# Storage for Backups and Snapshots
STORAGE_BACKEND="local" # local | s3
STORAGE_LOCAL_DIR="./storage/backups"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
